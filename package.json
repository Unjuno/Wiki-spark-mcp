{
  "name": "wiki-spark-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "Wikipedia-sourced randomized reasoning context via MCP",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node site/dev-server.mjs",
    "site:build": "node site/build.mjs",
    "check": "node scripts/check.mjs",
    "test:unit": "node --test test/wiki.test.mjs test/hardening.test.mjs",
    "test:protocol": "node --test test/mcp.test.mjs",
    "test": "node --test test/*.test.mjs",
    "test:live": "node scripts/live-smoke.mjs"
  },
  "dependencies": { "@modelcontextprotocol/server": "2.4.0", "zod": "^4.2.0" },
  "devDependencies": { "@modelcontextprotocol/client": "2.4.0" },
  "license": "MIT"
}
